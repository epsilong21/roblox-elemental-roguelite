{
  "name": "Roguelite",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Roguelite": {
        "$className": "Folder",
        "Shared": {
          "$path": "src/shared"
        },
        "Config": {
          "$path": "src/config"
        }
      }
    },
    "ServerScriptService": {
      "RogueliteServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMode": "Classic",
        "CameraMaxZoomDistance": 18,
        "CameraMinZoomDistance": 18,
        "DevComputerCameraMovementMode": "Follow",
        "DevTouchCameraMovementMode": "Follow",
        "DevCameraOcclusionMode": "Invisicam"
      },
      "StarterPlayerScripts": {
        "RogueliteClient": {
          "$path": "src/client"
        }
      }
    }
  }
}
